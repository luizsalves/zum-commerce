rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Fotos de produto: públicas para leitura (a Shopify baixa daqui), envio só por quem administra a loja.
    match /tenants/{tenantId}/products/{file} {
      allow read: if true;
      allow create, update: if request.auth != null
        && firestore.exists(/databases/(default)/documents/tenants/$(tenantId)/members/$(request.auth.uid))
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }
  }
}

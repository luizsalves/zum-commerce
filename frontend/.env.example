# Firebase (Console → Configurações do projeto → Seus apps → Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
VITE_FIREBASE_APP_ID=

# Loja usada quando o site roda em localhost (em produção a loja é descoberta pelo domínio).
VITE_DEFAULT_TENANT=elika

# Deixe vazio para usar /api no mesmo domínio (Firebase Hosting redireciona para o Cloud Run).
VITE_API_URL=
